{
  "name": "@pathofdev/server",
  "version": "0.0.0",
  "description": "Path of Dev game server: the HTTP API, the write path and storage around the rules engine",
  "type": "module",
  "exports": {
    ".": {
      "@pathofdev/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/eliraz-refael/path-of-dev.git",
    "directory": "packages/server"
  },
  "license": "MIT",
  "scripts": {
    "start": "node --conditions=@pathofdev/source src/main.ts"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0",
    "@effect/sql-pglite": "4.0.0",
    "@electric-sql/pglite": "0.5.8",
    "@pathofdev/engine": "workspace:*",
    "@pathofdev/schema": "workspace:*",
    "effect": "4.0.0"
  }
}
