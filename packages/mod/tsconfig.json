{
  // The engine lays .claude-plugin/types/ (the claude-code API) when it loads the mod; it is not committed.
  "extends": "./.claude-plugin/types/tsconfig.json",
  "compilerOptions": {
    "customConditions": ["@pathofdev/source"],
    "allowImportingTsExtensions": true,
    "exactOptionalPropertyTypes": true
  },
  // The engine's tsconfig takes hooks/, types/ and tests/; the properties in test/ (run by vitest) too.
  "include": ["hooks", "types", "tests", "test"]
}
